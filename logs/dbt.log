        create or replace table `workspace`.`pl_data`.`stg_data`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      WITH source_data AS (

    SELECT
        *
    FROM
        `workspace`.`pl_data`.`pl_data`
),
stats AS (
    SELECT
        AVG(gf) AS avg_gf,
        AVG(ga) AS avg_ga,
        AVG(xG) AS avg_xg,
        AVG(xGA) AS avg_xga,
        AVG(poss) AS avg_poss,
        AVG(attendance) AS avg_attendance,
    FROM
        source_data
),
mode_formation AS (
    SELECT
        formation,
        captain,
        formation,
        opp_formation,
        referee,
        match_report,
        notes
    FROM
        source_data
    WHERE
        formation IS NOT NULL
        AND captain IS NOT NULL
        AND formation IS NOT NULL
        AND opp_formation IS NOT NULL
        AND referee IS NOT NULL
        AND match_report IS NOT NULL
        AND notes IS NOT NULL
    GROUP BY
        formation,
        captain,
        formation,
        opp_formation,
        referee,
        match_report,
        notes
    ORDER BY
        COUNT(*) DESC
    LIMIT
        1
)
SELECT
    COALESCE(
        p.gf,
        s.avg_gf
    ) AS gf,
    COALESCE(
        p.ga,
        s.avg_ga
    ) AS ga,
    COALESCE(
        p.xG,
        s.avg_xg
    ) AS xG,
    COALESCE(
        p.xGA,
        s.avg_xga
    ) AS xGA,
    COALESCE(
        p.poss,
        s.avg_poss
    ) AS poss,
    COALESCE(
        p.attendance,
        s.avg_attendance
    ) AS attendance,
    COALESCE(
        p.formation,
        mf.formation
    ) AS formation,
    COALESCE(
        p.captain,
        mf.captain
    ) AS captain,
    COALESCE(
        p.formation,
        mf.formation
    ) AS formation,
    COALESCE(
        p.opp_formation,
        mf.opp_formation
    ) AS opp_formation,
    COALESCE(
        p.referee,
        mf.referee
    ) AS referee,
    COALESCE(
        p.match_report,
        mf.match_report
    ) AS match_report,
    COALESCE(
        p.notes,
        mf.notes
    ) AS notes
FROM
    source_data p
    CROSS JOIN stats s
    CROSS JOIN mode_formation mf
  
