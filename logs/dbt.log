[0m15:03:54.629180 [debug] [Thread-3 (]: On model.dasboard_pl.stg_data: /* {"app": "dbt", "dbt_version": "1.11.8", "dbt_databricks_version": "1.12.0", "databricks_sql_connector_version": "4.1.5", "profile_name": "dasboard_pl", "target_name": "dev", "invocation_id": "bda945f0-f559-4e01-8e0e-1e872562bf26", "node_id": "model.dasboard_pl.stg_data"} */

  
    
        create or replace table `workspace`.`pl_data`.`stg_data`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      WITH source_data AS (
    SELECT * from `workspace`.`pl_data`.`pl_data`
),
 stats AS (
     SELECT
        AVG(GF) AS avg_gf,
        AVG(GA) AS avg_ga,
        AVG(xG) AS avg_xg,
        AVG(xGA) AS avg_xga,
        AVG(Poss) AS avg_poss,
        AVG(attendance) AS avg_attendance
    FROM source_data
 ),

mode_formation AS (
    SELECT Formation, Captain, Opp_Formation, Referee, match_report, notes
    FROM source_data
    WHERE Formation IS NOT NULL and Captain IS NOT NULL and Opp_Formation IS NOT NULL and Referee IS NOT NULL and match_report IS NOT NULL and notes IS NOT NULL
    GROUP BY Formation, Captain, Opp_Formation, Referee, match_report, notes
    ORDER BY COUNT(*) DESC
    LIMIT 1
)

SELECT
    COALESCE(p.GF, s.avg_gf) AS GF,
    COALESCE(p.GA, s.avg_ga) AS GA,
    COALESCE(p.xG, s.avg_xg) AS xG,
    COALESCE(p.xGA, s.avg_xga) AS xGA,
    COALESCE(p.Poss, s.avg_poss) AS Poss,
    COALESCE(p.attendance, s.avg_attendance) AS attendance,
    COALESCE(p.Captain, mf.Captain) AS Captain,
    COALESCE(p.Formation, mf.Formation) AS Formation,
    COALESCE(p.Opp_Formation, mf.Opp_Formation) AS Opp_Formation,
    COALESCE(p.Referee, mf.Referee) AS Referee,
    COALESCE(p.match_report, mf.match_report) AS match_report,
    COALESCE(p.notes, mf.notes) AS notes
FROM source_data p
CROSS JOIN stats s
CROSS JOIN mode_formation mf
  
