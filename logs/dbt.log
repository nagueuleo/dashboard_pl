[0m11:38:06.164758 [debug] [Thread-6 (]: On model.dashboard_pl.Fact_pldata: /* {"app": "dbt", "dbt_version": "1.11.8", "dbt_databricks_version": "1.12.0", "databricks_sql_connector_version": "4.1.5", "profile_name": "dashboard_pl", "target_name": "dev", "invocation_id": "626dd386-5ad2-479e-ac5d-2f3ca486ade7", "node_id": "model.dashboard_pl.Fact_pldata"} */
select * from (
        with stats_data as (
    select
        row_number() over(
            order by l.date, l.team, l.opponent
        ) as stats_key,
        l.league,
        l.season,
        t.team,
        l.opponent,
        l.game,
        l.date,
        l.time,
        l.round,
        l.day,
        l.venue,
        l.result,
        l.GF,
        l.GA,
        l.xG,
        l.xGA,
        l.Poss,
        l.attendance,
        l.Captain,
        l.Formation,
        l.Opp_Formation,
        l.Referee,
        l.match_report,
        f.formation_key,
        r.refree_key,
        t.team_key,
        v.venue_key,
        o.opponent_key,
        d.date_key

    from `workspace`.`pl_data`.`int_pl_data` l

    left join `workspace`.`pl_data`.`dim_formation` f
        on l.Formation = f.Formation

    left join `workspace`.`pl_data`.`dim_refree` r
        on l.Referee = r.Referee

    left join `workspace`.`pl_data`.`dim_team` t
        on l.team = t.team

    left join `workspace`.`pl_data`.`dim_venue` v
        on l.venue = v.venue

    left join `workspace`.`pl_data`.`dim_opponent` o
        on l.opponent = o.opponent

    left join `workspace`.`pl_data`.`dim_date` d
        on l.date = d.full_date
)

select *
from stats_data
    ) as __dbt_sbq
    where false
    limit 0

