  create or replace view `workspace`.`pl_data`.`alerts_dbt_models`
  
  as (
    with
    error_models as (

        select
            model_execution_id,
            unique_id,
            invocation_id,
            name,
            generated_at,
            status,
            full_refresh,
            message,
            execution_time,
            execute_started_at,
            execute_completed_at,
            compile_started_at,
