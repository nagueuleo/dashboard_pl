            test_short_name,
            test_params,
            severity,
            status,
            result_rows
        from elementary_test_results
        where
            
    
      (1 = 1)
    

            and lower(status) != 'pass'and lower(status) != 'skipped'and test_type = 'schema_change'
    )

select *
from alerts_schema_changes
  )

