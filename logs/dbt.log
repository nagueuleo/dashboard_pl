    -- models/intermediate/int_matches_cleaned.sql
with  __dbt__cte__stg_data as (


WITH source_data AS (
    SELECT * from `workspace`.`pl_data`.`pl_data`
),
 renamed AS (
     SELECT
       league,
       season,
       team,
       game,
       date,
       time,
       round,
       day,
       venue,
       result,
       GF,
       GA,
       xG,
       xGA,
       Poss,
       coalesce(attendance, 73475) AS attendance,
       Captain,
       Formation,
       Opp_Formation,
       Referee,
       match_report,
       notes
     FROM source_data
     where Formation IS NOT NULL
 )
SELECT * FROM renamed
), base as (

    select * from __dbt__cte__stg_data

),

cleaned as (

    select
        season,

        team,
        trim(split_part(game, '-', 1)) as home_team,
        trim(split_part(game, '-', 2)) as away_team,

        case 
            when venue = 'Home' then team
            else null
        end as home_flag,
        date,
        cast(date as date) as full_date,
        time,
        round,
        day,
        venue,
        result,
        gf,
        ga,
        xg,
        xga,
        poss,
        attendance,
        captain,
        formation,
        opp_formation,
        referee,
        game,
        concat(
            season, '_',
            replace(team, ' ', ''), '_',
            replace(date, '-', ''), '_',
            replace(game, ' ', '')
        ) as bk_match

    from base

)

select * from cleaned
  )

