  create or replace view `dev`.`bronze`.`alerts_dbt_source_freshness`
  
  as (
    with
    results as (select * from `dev`.`bronze`.`dbt_source_freshness_results`),

    sources as (select * from `dev`.`bronze`.`dbt_sources`)

select
    results.source_freshness_execution_id as alert_id,
    results.max_loaded_at,
