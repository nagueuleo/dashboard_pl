  create or replace view `workspace`.`pl_data`.`alerts_schema_changes`
  
  as (
    with
    elementary_test_results as (select * from `workspace`.`pl_data`.`elementary_test_results`),

    alerts_schema_changes as (
        select
            id as alert_id,
            data_issue_id,
            test_execution_id,
            test_unique_id,
            model_unique_id,
            detected_at,
            database_name,
