\n\n) is not null), null))\n\n\n                    )\n                    / 1\n                )\n        end\n\n        \n\n        \n as job_run_execution_time\n        from `dev`.`bronze`.`dbt_invocations`\n        where job_id is not null\n        group by job_name, job_id, job_run_id\n    )\n\nselect\n    job_name as name,\n    job_id as id,\n    job_run_id as run_id,\n    job_run_started_at as run_started_at,\n    job_run_completed_at as run_completed_at,\n    job_run_execution_time as run_execution_time\nfrom jobs',null,'01f1ceef-9e41-1f05-b3f7-33d5e82d9cf6','Thread-5 (worker)','view','{"_message": "OK", "query_id": "01f1ceef-9e41-1f05-b3f7-33d5e82d9cf6"}',null),('c82698a3-a6f5-40e9-a5bb-9b1c5aaff620.model.elementary.snapshot_run_results','model.elementary.snapshot_run_results','c82698a3-a6f5-40e9-a5bb-9b1c5aaff620','2026-10-23 14:40:24',
