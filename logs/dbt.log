[0m16:39:53.099741 [debug] [Thread-6 (]: On model.elementary.monitors_runs: /* {"app": "dbt", "dbt_version": "1.12.5", "dbt_databricks_version": "1.12.7", "databricks_sql_connector_version": "4.4.0", "profile_name": "dashboard_pl", "target_name": "dev", "invocation_id": "c82698a3-a6f5-40e9-a5bb-9b1c5aaff620", "node_id": "model.elementary.monitors_runs"} */

  
  
  
  create or replace view `dev`.`bronze`.`monitors_runs`
  
  as (
    with
    data_monitoring_metrics as (select * from `dev`.`bronze`.`data_monitoring_metrics`),

    max_bucket_end as (

        select
            full_table_name,
            column_name,
            metric_name,
            metric_properties,
            max(bucket_end) as last_bucket_end,
            min(bucket_end) as first_bucket_end
        from data_monitoring_metrics
        group by full_table_name, column_name, metric_name, metric_properties

    )

select *
