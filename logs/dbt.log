        create or replace table `workspace`.`pl_data`.`fact_pldata`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      with stats_data as (
    select
        row_number() over(order by id) as stats_key,
        l.league,
        l.season,
        t.team,
        l.opponent,
        l.game,
        l.date,
        l.time,
        l.round,
        l.day,
        l.venue,
        l.result,
        l.GF,
        l.GA,
        l.xG,
        l.xGA,
        l.Poss,
        l.attendance,
        l.Captain,
        l.Formation,
        l.Opp_Formation,
        l.Referee,
        l.match_report,
        f.formation_key,
        r.refree_key,
        t.team_key,
        v.venue_key,
        o.opponent_key,
        d.date_key
    from `workspace`.`pl_data`.`int_pl_data` as l
    left join `workspace`.`pl_data`.`dim_formation` as f 
    on l.Formation = f.Formation
    left join `workspace`.`pl_data`.`dim_refree` as r 
    on l.Referee = r.Referee
    left join `workspace`.`pl_data`.`dim_team` as t 
    on l.team = t.team
    left join `workspace`.`pl_data`.`dim_venue` as v 
    on l.venue = v.venue
    left join `workspace`.`pl_data`.`dim_opponent` as o 
    on l.opponent = o.opponent
    left join `workspace`.`pl_data`.`dim_date` as d 
    on l.date = d.full_date
)
