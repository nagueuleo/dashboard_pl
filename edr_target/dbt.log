{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"ee442da2-fdbb-4d12-95de-9dbe03264176\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"ee442da2-fdbb-4d12-95de-9dbe03264176\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'seed' as type\n        from `workspace`.`pl_data`.`dbt_seeds`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'snapshot' as type\n        from `workspace`.`pl_data`.`dbt_snapshots`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'model' as type\n        from `workspace`.`pl_data`.`dbt_models`\n        \n            where package_name != 'elementary'\n        \n        union all\n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'source' as type\n        from `workspace`.`pl_data`.`dbt_sources`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            null as materialization,\n            'exposure' as type\n        from `workspace`.`pl_data`.`dbt_exposures`\n    \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "ee442da2-fdbb-4d12-95de-9dbe03264176", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"ee442da2-fdbb-4d12-95de-9dbe03264176\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"ee442da2-fdbb-4d12-95de-9dbe03264176\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'seed' as type\n        from `workspace`.`pl_data`.`dbt_seeds`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'snapshot' as type\n        from `workspace`.`pl_data`.`dbt_snapshots`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'model' as type\n        from `workspace`.`pl_data`.`dbt_models`\n        \n            where package_name != 'elementary'\n        \n        union all\n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'source' as type\n        from `workspace`.`pl_data`.`dbt_sources`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            null as materialization,\n            'exposure' as type\n        from `workspace`.`pl_data`.`dbt_exposures`\n    \n\n  ", "name": "SQLQuery", "pid": 9584, "thread": "MainThread", "ts": "2026-06-09T09:24:00.478900Z"}}
