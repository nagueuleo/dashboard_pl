{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.dashboard_pl.Dim_date\", \"invocation_id\": \"34770c9b-5254-4a21-9596-85a1f624e55e\", \"name\": \"Dim_date\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 9.9, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with date_spine as (            with rawdata as (                  with p as (         select 0 as generated_number union all select 1     ), unioned as (      select           p0.generated_number * power(2, 0)      +           p1.generated_number * power(2, 1)      +           p2.generated_number * power(2, 2)      +           p3.generated_number * power(2, 3)      +           p4.generated_number * power(2, 4)      +           p5.generated_number * power(2, 5)      +           p6.generated_number * power(2, 6)      +           p7.generated_number * power(2, 7)      +           p8.generated_number * power(2, 8)      +           p9.generated_number * power(2, 9)               + 1     as generated_number      from           p as p0      cross join           p as p1      cross join           p as p2      cross join           p as p3      cross join           p as p4      cross join           p as p5      cross join           p as p6      cross join           p as p7      cross join           p as p8      cross join           p as p9                )      select *     from unioned     where generated_number <= 729     order by generated_number    ),  all_periods as (      select (         timestampadd(day, row_number() over (order by generated_number) - 1, '2025-01-01')     ) as date_day     from rawdata  ),  filtered as (      select *     from all_periods     where date_day <= '2026-12-31'  )  select * from filtered    )  select      cast(date_format(date_day, 'yyyyMMdd') as int) as date_key,     date_day as full_date,     year(date_day) as year,     month(date_day) as month,     day(date_day) as day,      date_format(date_day, 'MMM') as month_name,     date_format(date_day, 'E') as day_name  from date_spine\", \"generated_at\": \"2026-06-09 10:01:32\"}, {\"unique_id\": \"model.dashboard_pl.Dim_formation\", \"invocation_id\": \"34770c9b-5254-4a21-9596-85a1f624e55e\", \"name\": \"Dim_formation\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 4.8, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with formation_data as (      select distinct         row_number() over(order by Formation) as formation_key,         Formation,         Opp_Formation     from `workspace`.`pl_data`.`int_pl_data`     group by Formation, Opp_Formation     order by Formation ASC ) select * from formation_data\", \"generated_at\": \"2026-06-09 10:01:32\"}, {\"unique_id\": \"model.dashboard_pl.Dim_opponent\", \"invocation_id\": \"34770c9b-5254-4a21-9596-85a1f624e55e\", \"name\": \"Dim_opponent\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 6.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with opponent_data as (      select distinct         row_number() over(order by opponent) as opponent_key,         opponent     from `workspace`.`pl_data`.`int_pl_data`     group by opponent     order by opponent ASC ) select * from opponent_data\", \"generated_at\": \"2026-06-09 10:01:32\"}, {\"unique_id\": \"model.dashboard_pl.Dim_refree\", \"invocation_id\": \"34770c9b-5254-4a21-9596-85a1f624e55e\", \"name\": \"Dim_refree\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 5.8, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with refree_data as (      select distinct         row_number() over(order by Referee) as refree_key,         Referee     from `workspace`.`pl_data`.`int_pl_data`     group by Referee     order by Referee ASC ) select * from refree_data\", \"generated_at\": \"2026-06-09 10:01:32\"}, {\"unique_id\": \"model.dashboard_pl.Dim_team\", \"invocat