{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"a98f97ca-7581-4d5b-9b77-1feca58dac5d\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"a98f97ca-7581-4d5b-9b77-1feca58dac5d\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n              with dbt_artifacts_exposures as (\n                select\n                  name,\n                  \n                    label,\n                  \n                  unique_id,\n                  url,\n                  type,\n                  maturity,\n                  owner_email,\n                  owner_name as owners,\n                  tags,\n                  package_name,\n                  description,\n                  meta,\n                  original_path as full_path,\n                  \n                    raw_queries,\n                  \n                  depends_on_nodes,\n                  \n                    depends_on_columns\n                  \n\n                from `workspace`.`pl_data`.`dbt_exposures`\n              )\n\n             select * from dbt_artifacts_exposures\n        \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "a98f97ca-7581-4d5b-9b77-1feca58dac5d", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"a98f97ca-7581-4d5b-9b77-1feca58dac5d\", \"connection_name\": \"macro_log_macro