{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"c050f704-d17e-4cd0-b8d3-6782ee1260e8\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"c050f704-d17e-4cd0-b8d3-6782ee1260e8\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        run_results.unique_id,\n        run_results.invocation_id,\n        row_number() over (partition by run_results.unique_id order by run_results.generated_at desc) as row_number\n      from `workspace`.`pl_data`.`dbt_run_results` run_results\n      join `workspace`.`pl_data`.`dbt_models` models on run_results.unique_id = models.unique_id\n    ),\n\n    latest_run_results as (\n      select unique_id, invocation_id\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results\n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "c050f704-d17e-4cd0-b8d3-6782ee1260e8", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"c050f704-d17e-4cd0-b8d3-6782ee1260e8\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"c050f704-d17e-4cd0-b8d3-6782ee1260e8\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n    with ordered_run_results as (\n      select\n        run_results.unique_id,\n        run_results.invocation_id,\n        row_number() over (partition by run_results.unique_id order by run_results.generated_at desc) as row_number\n      from `workspace`.`pl_data`.`dbt_run_results` run_results\n      join `workspace`.`pl_data`.`dbt_models` models on run_results.unique_id = models.unique_id\n    ),\n\n    latest_run_results as (\n      select unique_id, invocation_id\n      from ordered_run_results\n      where row_number = 1\n    )\n\n    select unique_id, invocation_id from latest_run_results\n  \n\n  ", "name": "SQLQuery", "pid": 11536, "thread": "MainThread", "ts": "2026-06-09T09:40:38.489694Z"}}
