{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.dashboard_pl.Dim_date\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Dim_date\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 12.5, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with date_spine as (            with rawdata as (                  with p as (         select 0 as generated_number union all select 1     ), unioned as (      select           p0.generated_number * power(2, 0)      +           p1.generated_number * power(2, 1)      +           p2.generated_number * power(2, 2)      +           p3.generated_number * power(2, 3)      +           p4.generated_number * power(2, 4)      +           p5.generated_number * power(2, 5)      +           p6.generated_number * power(2, 6)      +           p7.generated_number * power(2, 7)      +           p8.generated_number * power(2, 8)      +           p9.generated_number * power(2, 9)               + 1     as generated_number      from           p as p0      cross join           p as p1      cross join           p as p2      cross join           p as p3      cross join           p as p4      cross join           p as p5      cross join           p as p6      cross join           p as p7      cross join           p as p8      cross join           p as p9                )      select *     from unioned     where generated_number <= 729     order by generated_number    ),  all_periods as (      select (         timestampadd(day, row_number() over (order by generated_number) - 1, '2025-01-01')     ) as date_day     from rawdata  ),  filtered as (      select *     from all_periods     where date_day <= '2026-12-31'  )  select * from filtered    )  select      cast(date_format(date_day, 'yyyyMMdd') as int) as date_key,     date_day as full_date,     year(date_day) as year,     month(date_day) as month,     day(date_day) as day,      date_format(date_day, 'MMM') as month_name,     date_format(date_day, 'E') as day_name  from date_spine\", \"generated_at\": \"2026-06-09 09:38:17\"}, {\"unique_id\": \"model.dashboard_pl.Dim_formation\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Dim_formation\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 7.3, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with formation_data as (      select distinct         row_number() over(order by Formation) as formation_key,         Formation,         Opp_Formation     from `workspace`.`pl_data`.`int_pl_data`     group by Formation, Opp_Formation     order by Formation ASC ) select * from formation_data\", \"generated_at\": \"2026-06-09 09:38:17\"}, {\"unique_id\": \"model.dashboard_pl.Dim_opponent\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Dim_opponent\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 6.8, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with opponent_data as (      select distinct         row_number() over(order by opponent) as opponent_key,         opponent     from `workspace`.`pl_data`.`int_pl_data`     group by opponent     order by opponent ASC ) select * from opponent_data\", \"generated_at\": \"2026-06-09 09:38:17\"}, {\"unique_id\": \"model.dashboard_pl.Dim_refree\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Dim_refree\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 5.7, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with refree_data as (      select distinct         row_number() over(order by Referee) as refree_key,         Referee     from `workspace`.`pl_data`.`int_pl_data`     group by Referee     order by Referee ASC ) select * from refree_data\", \"generated_at\": \"2026-06-09 09:38:17\"}, {\"unique_id\": \"model.dashboard_pl.Dim_team\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Dim_team\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 5.4, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with team_data as (      select distinct         row_number() over(order by team) as team_key,         team     from `workspace`.`pl_data`.`int_pl_data`     group by team     order by team ASC ) select * from team_data\", \"generated_at\": \"2026-06-09 09:38:17\"}, {\"unique_id\": \"model.dashboard_pl.Dim_venue\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Dim_venue\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 6.4, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with venue_data as (      select distinct         row_number() over(order by venue) as venue_key,         venue     from `workspace`.`pl_data`.`int_pl_data`     group by venue     order by venue ASC ) select * from venue_data\", \"generated_at\": \"2026-06-09 09:38:17\"}, {\"unique_id\": \"model.dashboard_pl.Fact_pldata\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Fact_pldata\", \"schema\": \"pl_data\", \"status\": \"error\", \"execution_time\": 0, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"with stats_data as (     select         row_number() over(             order by l.date, l.team, l.opponent         ) as stats_key,         l.league,         l.season,         t.team,         l.opponent,         l.game,         l.date,         l.time,         l.round,         l.day,         l.venue,         l.result,         l.GF,         l.GA,         l.xG,         l.xGA,         l.Poss,         l.attendance,         l.Captain,         l.Formation,         l.Opp_Formation,         l.Referee,         l.match_report,         f.formation_key,         r.refree_key,         t.team_key,         v.venue_key,         o.opponent_key,         d.date_key      from `workspace`.`pl_data`.`int_pl_data` l      left join `workspace`.`pl_data`.`dim_formation` f         on l.Formation = f.Formation      left join `workspace`.`pl_data`.`dim_refree` r         on l.Referee = r.Referee      left join `workspace`.`pl_data`.`dim_team` t         on l.team = t.team      left join `workspace`.`pl_data`.`dim_venue` v         on l.venue = v.venue      left join `workspace`.`pl_data`.`dim_opponent` o         on l.opponent = o.opponent      left join `workspace`.`pl_data`.`dim_date` d         on l.date = d.full_date )  select * from stats_data\", \"generated_at\": \"2026-06-09 09:38:17\"}, {\"unique_id\": \"model.dashboard_pl.int_pl_data\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"int_pl_data\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 2.3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"  WITH  __dbt__cte__stg_data as (   WITH source_data AS (     SELECT * from `workspace`.`pl_data`.`pl_data` ),  renamed AS (      SELECT        league,        season,        team,        game,        date,        time,        round,        day,        venue,        result,        GF,        GA,        xG,        xGA,        Poss,        coalesce(attendance, 73475) AS attendance,        opponent,        Captain,        Formation,        Opp_Formation,        Referee,        match_report,        notes      FROM source_data      where Formation IS NOT NULL  ) SELECT * FROM renamed ), data_pl AS (     select         league,        season,        team,        opponent,        split_part(game, ' ', 2) as game,        date,        time,        round,        day,        venue,        result,        GF,        GA,        xG,        xGA,        Poss,        attendance,        Captain,        Formation,        Opp_Formation,        Referee,        match_report     from __dbt__cte__stg_data ) select * from data_pl\", \"generated_at\": \"2026-06-09 09:38:17\"}]--ELEMENTARY-MACRO-OUTPUT-END--"}, "info": {"category": "", "code": "I062", "extra": {}, "invocation_id": "f982655a-a2d1-4feb-a03c-a44b859927df", "level": "info", "msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.dashboard_pl.Dim_date\", \"invocation_id\": \"626dd386-5ad2-479e-ac5d-2f3ca486ade7\", \"name\": \"Dim_date\", \"schema\": \"pl_data\", \"status\": \"success\", \"execution_time\": 12.5, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"  with date_spine as (            with rawdata as (                  with p as (         select 0 as generated_number union all select 1     ), unioned as (      select           p0.generated_number * power(2, 0)      +           p1.generated_number * power(2, 1)      +           p2.generated_number * power(2, 2)      +           p3.generated_number * power(2, 3)      +           p4.generated_number * power(2, 4)      +           p5.generated_number * power(2, 5)      +           p6.generated_number * power(2, 6)      +           p7.generated_number * power(2, 7)      +           p8.generated_number * power(2, 8)      +           p9.generated_number * power(2, 9)               + 1     as generated_number      from           p as p0      cross join           p as p1      cross join           p as p2      cross join           p as p3      cross join           p as p4      cross join           p as p5      cross join           p as p6      cross join           p as p7      cross join           p as p8      cross join           p as p9                )      select *     from unioned     where generated_number <= 729     order by generated_number    ),  all_periods as (      select (         timestampadd(day, row_number() over (order by generated_number) - 1, '2025-01-01')     ) as date_day     from rawdata  ),  filtered as (      select *     from all_periods     where date_day <= '2026-12-31'  )  select * from filtered    )  select      cast(date_format(date_day, 'yyyyMMdd') as int) as 