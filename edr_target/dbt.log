{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"f532de4c-9971-45fa-aa39-2a523bf6ebb2\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"f532de4c-9971-45fa-aa39-2a523bf6ebb2\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_artifacts_seeds as (\n          select\n            name,\n            unique_id,\n            database_name,\n            schema_name,\n            case when alias is not null then alias\n            else name end as table_name,\n            owner as owners,\n            tags,\n            package_name,\n            description,\n            original_path as full_path\n          from `workspace`.`pl_data`.`dbt_seeds`\n        )\n\n        select * from dbt_artifacts_seeds\n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "f532de4c-9971-45fa-aa39-2a523bf6ebb2", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.11.8\", \"dbt_databricks_version\": \"1.12.0\", \"databricks_sql_connector_version\": \"4.1.5\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"f532de4c-9971-45fa-aa39-2a523bf6ebb2\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"f532de4c-9971-45fa-aa39-2a523bf6ebb2\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with db